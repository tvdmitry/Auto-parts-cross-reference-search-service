# Необязательно: переопределение ключа для локального серверного режима.
# По умолчанию используется публичный ключ из примеров wsprice.pdf.
# Не добавляйте префикс VITE_ к личному ключу.
FAVORIT_API_KEY=00000000-0000-0000-0000-000000000001

# Только для npm start. По умолчанию приложение доступно локально.
HOST=127.0.0.1
PORT=3000
